# Laravel API, reached server-side (inside Docker: http://api:8000)
API_URL=http://localhost:8000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Tunduk Trips"

# WhatsApp Business number, digits only (e.g. 996555123456). Empty: WhatsApp asks whom to send the message to.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Shown in the footer and on "Plan my trip" when set, e.g. hello@tunduktrips.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Shows the "sample data" notice while the catalog runs on demo content. Set to false at launch.
NEXT_PUBLIC_DEMO_CONTENT=true
